{
  "demo_agent": {
    "description": "Demo harness: logs steps, spawns a subprocess, asks for one approval",
    "argv": ["python", "examples/demo_harness.py", "--steps", "{steps}"],
    "params": {"steps": {"pattern": "^[1-9][0-9]{0,3}$", "default": "20"}}
  },
  "repo_tests": {
    "description": "Run the repo's test suite",
    "argv": ["python", "-m", "pytest", "-q", "{target}"],
    "cwd": "/srv/myrepo",
    "params": {"target": {"pattern": "^[A-Za-z0-9_./-]{1,200}$", "default": "tests"}}
  },
  "overnight_agent": {
    "description": "Your coding harness. Edit argv to point at it.",
    "argv": ["/srv/harness/run-agent", "--task-file", "{task_file}"],
    "cwd": "/srv/myrepo",
    "params": {"task_file": {"pattern": "^tasks/[A-Za-z0-9_-]{1,64}\\.md$"}},
    "requires_approval": true
  }
}
